# ==============================================================================
# CLOUDPULSE ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT MODE (No AWS credentials needed)
# ------------------------------------------------------------------------------
USE_LOCAL_STORAGE=true
STORAGE_BACKEND=sqlite
NOTIFICATION_BACKEND=local
SQLITE_DB_PATH=cloudpulse.db
LOCAL_JWT_SECRET=cloudpulse-dev-secret-key-32chars!!
PORT=5000

# Frontend local API target (Vite dev server proxy)
VITE_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# AWS PRODUCTION CLOUD MODE (Populated from AWS SAM outputs)
# ------------------------------------------------------------------------------
# Set USE_LOCAL_STORAGE=false to enable real AWS services
# USE_LOCAL_STORAGE=false
# STORAGE_BACKEND=dynamodb
# NOTIFICATION_BACKEND=sns

# AWS Region
AWS_REGION=us-east-1

# Amazon DynamoDB Tables
MONITORS_TABLE=cloudpulse-monitors-prod
CHECKS_TABLE=cloudpulse-checks-prod
INCIDENTS_TABLE=cloudpulse-incidents-prod

# Amazon SNS Topic
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cloudpulse-alerts-prod

# Amazon Cognito User Pool
COGNITO_USER_POOL_ID=us-east-1_exampleId
COGNITO_CLIENT_ID=exampleClientId123456

# Production API Gateway Base URL
# VITE_API_URL=https://abc123xyz.execute-api.us-east-1.amazonaws.com
